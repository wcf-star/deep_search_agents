# 复制为 .env 后填入真实值。此文件不含密钥，可提交到仓库。

# ===== LLM 配置（OpenAI 兼容，例：通义 Qwen）=====
LLM_QWEN_MAX=your-model-name
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=

# ===== RAGFlow 知识库 =====
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# ===== MySQL 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ===== 前端跨域白名单（逗号分隔）=====
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
